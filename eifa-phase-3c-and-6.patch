+import fs from 'node:fs';
+import path from 'node:path';
+
+import type { Audience } from '@/lib/catalog';
+
+/**
+ * Editorial content for the Women / Men / Accessories blocks, shared by
+ * the homepage sections and the dedicated /women, /men and /accessories
+ * pages so the two can never drift apart.
+ */
+export interface AudienceContent {
+  audience: Audience;
+  path: string;
+  eyebrow: string;
+  title: string;
+  tagline: string;
+  intro: string;
+  cta: string;
+  chips: string[];
+  image: string;
+  imageAlt: string;
+  /** Background of the homepage block. */
+  section: string;
+  dark: boolean;
+  imageRight: boolean;
+}
+
+const DUPATTA_FALLBACK = '/images/categories/dupattas.png';
+
+/**
+ * Accessories lead image. Drop a silk-bag / potli + dupatta photo at
+ * public/images/collections/accessories.(webp|jpg|jpeg|png) and it is
+ * picked up automatically; until then the dupatta photo is used.
+ */
+function resolveAccessoriesImage(): string {
+  for (const ext of ['webp', 'jpg', 'jpeg', 'png']) {
+    const file = `accessories.${ext}`;
+    if (fs.existsSync(path.join(process.cwd(), 'public', 'images', 'collections', file))) {
+      return `/images/collections/${file}`;
+    }
+  }
+  return DUPATTA_FALLBACK;
+}
+
+export function getAudienceContent(audience: Audience): AudienceContent {
+  switch (audience) {
+    case 'women':
+      return {
+        audience,
+        path: '/women',
+        eyebrow: 'For Her',
+        title: "Women's Collection",
+        tagline: 'A canvas of Lucknowi artistry',
+        intro: 'Sarees, kurta sets, anarkalis and bridal wear, hand-embroidered by our karigars.',
+        cta: "Explore Women's Collection",
+        chips: ['Sarees', 'Kurta Sets', 'Anarkalis', 'Bridal'],
+        image: '/images/categories/sarees.png',
+        imageAlt: 'Model draped in an ivory Chikankari saree',
+        section: 'bg-ivory',
+        dark: false,
+        imageRight: false,
+      };
+    case 'men':
+      return {
+        audience,
+        path: '/men',
+        eyebrow: 'For Him',
+        title: "Men's Collection",
+        tagline: 'Understated, timeless, refined',
+        intro: 'Chikankari kurtas in cotton, silk and linen for festive days and every day.',
+        cta: "Explore Men's Collection",
+        chips: ['Kurtas', 'Kurta Sets', 'Festive', 'Everyday'],
+        image: '/images/collections/men.png',
+        imageAlt: 'Model in an ivory Chikankari kurta',
+        section: 'bg-espresso',
+        dark: true,
+        imageRight: true,
+      };
+    case 'accessories':
+      return {
+        audience,
+        path: '/accessories',
+        eyebrow: 'The Finishing Touch',
+        title: 'Bags & Accessories',
+        tagline: 'Silk bags, potlis and dupattas',
+        intro: 'Silk bags, potlis, clutches and hand-embroidered dupattas to complete every look.',
+        cta: 'Explore Accessories',
+        chips: ['Silk Bags', 'Potlis', 'Dupattas', 'Stoles'],
+        image: resolveAccessoriesImage(),
+        imageAlt: 'Silk bags and hand-embroidered dupattas',
+        section: 'bg-parchment',
+        dark: false,
+        imageRight: false,
+      };
+  }
+}
diff --git a/src/lib/data/categories.ts b/src/lib/data/categories.ts
index 8d9ca52..e1a7f0c 100644
--- a/src/lib/data/categories.ts
+++ b/src/lib/data/categories.ts
@@ -58,3 +58,69 @@ export async function fetchCategoryBySlug(
   if (error || !data) return null;
   return mapCategoryRow(data as DbCategory);
 }
+
+/**
+ * Active categories with a guaranteed REAL image: the admin-uploaded
+ * category image first, otherwise the newest product photo in that
+ * category (or its sub-categories), and only then the bundled
+ * placeholder. Keeps homepage and audience tiles relevant without the
+ * admin having to upload a picture for every category.
+ */
+export async function fetchActiveCategoriesWithImages(
+  supabase: SupabaseClient
+): Promise<Category[]> {
+  const [categories, productResult] = await Promise.all([
+    fetchActiveCategories(supabase),
+    supabase
+      .from('products')
+      .select('category_id, product_images ( url, is_primary, sort_order, variant_id )')
+      .eq('is_active', true)
+      .is('deleted_at', null)
+      .not('category_id', 'is', null)
+      .order('created_at', { ascending: false })
+      .limit(300),
+  ]);
+
+  type Row = {
+    category_id: string;
+    product_images: { url: string; is_primary: boolean; sort_order: number; variant_id: string | null }[];
+  };
+
+  // Newest product image per category id.
+  const latestByCategory = new Map<string, string>();
+  for (const row of (productResult.data ?? []) as unknown as Row[]) {
+    if (latestByCategory.has(row.category_id)) continue;
+    const image = (row.product_images ?? [])
+      .filter((img) => !img.variant_id)
+      .sort((a, b) => (a.is_primary === b.is_primary ? a.sort_order - b.sort_order : a.is_primary ? -1 : 1))[0];
+    if (image) latestByCategory.set(row.category_id, image.url);
+  }
+
+  // Rows that have an uploaded image keep it; the rest fall back.
+  const { data: imageRows } = await supabase
+    .from('categories')
+    .select('id, image_url')
+    .eq('is_active', true)
+    .is('deleted_at', null);
+  const uploaded = new Set(
+    ((imageRows ?? []) as { id: string; image_url: string | null }[])
+      .filter((row) => !!row.image_url)
+      .map((row) => row.id)
+  );
+
+  const childrenOf = new Map<string, Category[]>();
+  for (const category of categories) {
+    if (!category.parentId) continue;
+    childrenOf.set(category.parentId, [...(childrenOf.get(category.parentId) ?? []), category]);
+  }
+
+  return categories.map((category) => {
+    if (uploaded.has(category.id)) return category;
+    const own = latestByCategory.get(category.id);
+    const fromChild = (childrenOf.get(category.id) ?? [])
+      .map((child) => latestByCategory.get(child.id))
+      .find(Boolean);
+    const image = own ?? fromChild;
+    return image ? { ...category, image } : category;
+  });
+}
diff --git a/src/lib/data/shop.ts b/src/lib/data/shop.ts
new file mode 100644
index 0000000..550f78e
--- /dev/null
+++ b/src/lib/data/shop.ts
@@ -0,0 +1,200 @@
+/* ============================================
+   EIFA COUTURE — Shop data access (server-side filtering)
+   ============================================
+   The shop page used to download every product and filter in the
+   browser. Everything is now filtered, sorted and paged by Supabase;
+   only the requested page of products is sent to the client.
+   ============================================ */
+
+import type { SupabaseClient } from '@supabase/supabase-js';
+
+import { expandCategorySlugs, type Audience } from '@/lib/catalog';
+import { SIZES } from '@/lib/constants';
+import { mapProductRow, PRODUCT_SELECT, type ProductRow } from '@/lib/data/products';
+import { getPriceBounds, type ShopFilters } from '@/lib/shop-filters';
+import type { Category, Product } from '@/types';
+
+export interface ShopFacets {
+  sizes: string[];
+  colors: { name: string; hex: string }[];
+  fabrics: string[];
+}
+
+export interface ShopResult {
+  products: Product[];
+  total: number;
+}
+
+const EMPTY: ShopResult = { products: [], total: 0 };
+
+/** Strips characters that have a meaning inside a PostgREST filter. */
+function safeSearchTerm(value: string): string {
+  return value.replace(/[%*,()"\\:]/g, ' ').replace(/\s+/g, ' ').trim();
+}
+
+interface VariantRow {
+  product_id: string;
+  size: string;
+  color_name: string;
+  inventory: { quantity: number; reserved: number } | { quantity: number; reserved: number }[] | null;
+}
+
+/**
+ * Product ids that have at least one active variant matching the size /
+ * colour / in-stock filters. Returns null when none of those filters is
+ * set (no restriction).
+ */
+async function fetchVariantProductIds(
+  supabase: SupabaseClient,
+  filters: ShopFilters
+): Promise<string[] | null> {
+  if (filters.sizes.length === 0 && filters.colors.length === 0 && !filters.inStock) return null;
+
+  let query = supabase
+    .from('product_variants')
+    .select('product_id, size, color_name, inventory ( quantity, reserved )')
+    .eq('is_active', true);
+  if (filters.sizes.length) query = query.in('size', filters.sizes);
+  if (filters.colors.length) query = query.in('color_name', filters.colors);
+
+  const { data, error } = await query.limit(5000);
+  if (error || !data) return [];
+
+  const ids = new Set<string>();
+  for (const row of data as unknown as VariantRow[]) {
+    if (filters.inStock) {
+      const inv = Array.isArray(row.inventory) ? row.inventory[0] : row.inventory;
+      if (!inv || inv.quantity - inv.reserved <= 0) continue;
+    }
+    ids.add(row.product_id);
+  }
+  return Array.from(ids);
+}
+
+export async function fetchShopProducts(
+  supabase: SupabaseClient,
+  filters: ShopFilters,
+  categories: Category[]
+): Promise<ShopResult> {
+  // Category (plus its sub-categories) -> ids. An unknown slug is ignored.
+  let categoryIds: string[] | null = null;
+  if (filters.category && categories.some((c) => c.slug === filters.category)) {
+    const slugs = expandCategorySlugs(categories, [filters.category]);
+    categoryIds = categories.filter((c) => slugs.has(c.slug)).map((c) => c.id);
+  }
+
+  const [variantProductIds, fabricIds] = await Promise.all([
+    fetchVariantProductIds(supabase, filters),
+    filters.fabrics.length
+      ? supabase
+          .from('fabrics')
+          .select('id')
+          .in('name', filters.fabrics)
+          .then(({ data }) => (data ?? []).map((row: { id: string }) => row.id))
+      : Promise.resolve(null),
+  ]);
+
+  if (variantProductIds && variantProductIds.length === 0) return EMPTY;
+  if (fabricIds && fabricIds.length === 0) return EMPTY;
+
+  let query = supabase
+    .from('products')
+    .select(PRODUCT_SELECT, { count: 'exact' })
+    .eq('is_active', true)
+    .is('deleted_at', null);
+
+  // Strict: the product's OWN audience, never guessed from the category.
+  if (filters.audience) query = query.eq('audience', filters.audience satisfies Audience);
+  if (categoryIds) query = query.in('category_id', categoryIds);
+  if (filters.collection === 'new-arrivals') query = query.eq('is_new_arrival', true);
+  if (filters.collection === 'best-sellers') query = query.eq('is_best_seller', true);
+  if (filters.collection === 'featured') query = query.eq('is_featured', true);
+  if (variantProductIds) query = query.in('id', variantProductIds);
+  if (fabricIds) query = query.in('fabric_id', fabricIds);
+
+  const bounds = getPriceBounds(filters.price);
+  if (bounds.gte !== undefined) query = query.gte('price', bounds.gte);
+  if (bounds.gt !== undefined) query = query.gt('price', bounds.gt);
+  if (bounds.lte !== undefined) query = query.lte('price', bounds.lte);
+  if (bounds.lt !== undefined) query = query.lt('price', bounds.lt);
+
+  const term = safeSearchTerm(filters.q);
+  if (term) {
+    query = query.or(
+      `name.ilike.%${term}%,short_description.ilike.%${term}%,description.ilike.%${term}%`
+    );
+  }
+
+  if (filters.sort === 'price-low-high') query = query.order('price', { ascending: true });
+  else if (filters.sort === 'price-high-low') query = query.order('price', { ascending: false });
+  query = query.order('created_at', { ascending: false }).order('id', { ascending: true });
+
+  const { data, error, count } = await query.range(0, filters.limit - 1);
+  if (error || !data) return EMPTY;
+
+  return {
+    products: (data as unknown as ProductRow[]).map(mapProductRow),
+    total: count ?? data.length,
+  };
+}
+
+/**
+ * Filter options that actually exist in the catalogue (scoped to the
+ * chosen audience), so a shopper is never offered a size, colour or
+ * fabric that matches nothing.
+ */
+export async function fetchShopFacets(
+  supabase: SupabaseClient,
+  audience: Audience | null
+): Promise<ShopFacets> {
+  let variantQuery = supabase
+    .from('product_variants')
+    .select('size, color_name, color_hex, products!inner ( is_active, deleted_at, audience )')
+    .eq('is_active', true)
+    .eq('products.is_active', true)
+    .is('products.deleted_at', null);
+  let fabricQuery = supabase
+    .from('products')
+    .select('fabrics ( name )')
+    .eq('is_active', true)
+    .is('deleted_at', null)
+    .not('fabric_id', 'is', null);
+  if (audience) {
+    variantQuery = variantQuery.eq('products.audience', audience);
+    fabricQuery = fabricQuery.eq('audience', audience);
+  }
+
+  const [variantResult, fabricResult] = await Promise.all([variantQuery.limit(5000), fabricQuery.limit(1000)]);
+
+  const sizeSet = new Set<string>();
+  const colorMap = new Map<string, string>();
+  for (const row of (variantResult.data ?? []) as unknown as {
+    size: string;
+    color_name: string;
+    color_hex: string | null;
+  }[]) {
+    sizeSet.add(row.size);
+    if (!colorMap.has(row.color_name)) colorMap.set(row.color_name, row.color_hex ?? '#CCCCCC');
+  }
+
+  const order = new Map<string, number>(SIZES.map((size, index) => [size, index]));
+  const sizes = Array.from(sizeSet).sort((a, b) => {
+    const oa = order.get(a) ?? 99;
+    const ob = order.get(b) ?? 99;
+    return oa === ob ? a.localeCompare(b) : oa - ob;
+  });
+
+  const fabrics = Array.from(
+    new Set(
+      ((fabricResult.data ?? []) as unknown as { fabrics: { name: string } | { name: string }[] | null }[])
+        .map((row) => (Array.isArray(row.fabrics) ? row.fabrics[0]?.name : row.fabrics?.name))
+        .filter((name): name is string => !!name)
+    )
+  ).sort((a, b) => a.localeCompare(b));
+
+  return {
+    sizes,
+    colors: Array.from(colorMap, ([name, hex]) => ({ name, hex })).sort((a, b) => a.name.localeCompare(b.name)),
+    fabrics,
+  };
+}
